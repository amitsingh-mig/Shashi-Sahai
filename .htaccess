# ==============================================================================
# Website Image Protection, SEO & Access Control (.htaccess)
# Domain: unfinishedframes.com
# ==============================================================================

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Canonical domain enforcement (optional for production HTTPS)
# RewriteCond %{HTTP_HOST} ^www\.unfinishedframes\.com [NC]
# RewriteRule ^(.*)$ https://unfinishedframes.com/$1 [L,R=301]

# 1. DEVELOPER MODE BYPASS (?mode=dev)
RewriteCond %{QUERY_STRING} (^|&)mode=dev(&|$) [NC,OR]
RewriteCond %{QUERY_STRING} (^|&)dev(&|$) [NC,OR]
RewriteCond %{HTTP_COOKIE} mode_dev=true [NC]
RewriteRule ^images/ - [L]

# 2. PREVENT DIRECT IMAGE ACCESS & HOTLINKING (NORMAL MODE)
# Block direct address bar navigation (empty referer) to protect raw image files
RewriteCond %{REQUEST_URI} ^/images/.*\.(webp|jpe?g|png|gif|svg)$ [NC]
RewriteCond %{HTTP_REFERER} ^$
RewriteRule ^images/.*\.(webp|jpe?g|png|gif|svg)$ - [F,L,NC]

# Allow legitimate domain referers (unfinishedframes.com) & local testing
RewriteCond %{REQUEST_URI} ^/images/.*\.(webp|jpe?g|png|gif|svg)$ [NC]
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?unfinishedframes\.com [NC]
RewriteCond %{HTTP_REFERER} !^https?://%{HTTP_HOST} [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?localhost [NC]
RewriteCond %{HTTP_REFERER} !^https?://127\.0\.0\.1 [NC]
RewriteCond %{HTTP_REFERER} !^https?://192\.168\. [NC]
RewriteRule ^images/.*\.(webp|jpe?g|png|gif|svg)$ - [F,L,NC]
</IfModule>

# 3. MIME TYPES & CACHING FOR SEO ASSETS
<IfModule mod_mime.c>
    AddType text/xml .xml
    AddType application/manifest+json .webmanifest
</IfModule>

# 4. SECURITY HEADERS FOR ASSET PROTECTION
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    <FilesMatch "\.(webp|jpe?g|png)$">
        Header set Cache-Control "private, no-transform"
    </FilesMatch>
    <FilesMatch "(sitemap\.xml|robots\.txt)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>
